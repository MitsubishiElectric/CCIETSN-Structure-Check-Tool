{
  "name": "ccietsn-structure-check-tool",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "shx mkdir -p public/data && shx cp -r src/data/connection-tables public/data/ && vite --host 0.0.0.0 --port 5173",
    "build": "vite build && shx mkdir -p dist/data && shx cp -r src/data/connection-tables dist/data/",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "format": "prettier --write .",
    "deploy": "npm run build && gh-pages -d dist -b gh-pages",
    "build:csp": "node scripts/build-csp-index.mjs",
    "sync:csp": "node scripts/sync-csp-to-csv.mjs",
    "build:device-defaults": "node scripts/build-device-defaults.mjs",
    "generate:test-cases": "node scripts/generate-test-cases.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@emotion/react": "^11.13.0",
    "@emotion/styled": "^11.13.0",
    "@mui/icons-material": "^6.5.0",
    "@mui/material": "^6.0.0",
    "nanoid": "^5.0.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "reactflow": "^11.10.2",
    "zod": "^3.23.8",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/node": "^24.6.2",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.3.1",
    "adm-zip": "^0.5.12",
    "bmp-js": "^0.1.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "fast-xml-parser": "^4.4.0",
    "gh-pages": "^6.1.1",
    "jimp": "^0.22.12",
    "prettier": "^3.3.3",
    "sharp": "^0.33.4",
    "shx": "^0.4.0",
    "typescript": "^5.6.2",
    "vite": "^5.4.6"
  }
}
